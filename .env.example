# AI-Powered Continuous Internship Task Review System
# Environment Configuration

# Optional: Google Gemini API Key for LLM review (if empty, built-in Intelligent Heuristic Mentor Engine runs automatically)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database (SQLite for portable demo, easily changeable to postgresql://... or mysql://...)
DATABASE_URL=sqlite:///./task_review.db

# JWT Security
SECRET_KEY=super-secret-enterprise-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Review Settings
CONFIDENCE_THRESHOLD=75.0
MAX_REVISION_ATTEMPTS=3

# File Limits
MAX_FILE_SIZE_MB=15
